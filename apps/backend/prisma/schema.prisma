// Prisma Schema for K-12 School Management System
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums
enum UserRole {
  SUPER_ADMIN
  PRINCIPAL
  OFFICE_STAFF
  ACCOUNTANT
  TEACHER
  STUDENT
  PARENT
}

enum GenderType {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  DETAINED
  TRANSFERRED
  ALUMNI
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMode {
  CASH
  CHEQUE
  POS_CARD
  ONLINE_GATEWAY
  BANK_TRANSFER
}

// Models
model Institution {
  id               String            @id @default(uuid())
  slug             String            @unique
  name             String
  affiliationCode  String?
  contactEmail     String
  contactPhone     String
  address          String
  logoUrl          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  users            User[]
  academicYears    AcademicYear[]
  classes          Class[]
  guardians        Guardian[]
  students         Student[]
  subjects         Subject[]
  feeHeads         FeeHead[]
  feeCards         FeeCard[]
  feeInvoices      FeeInvoice[]
  auditLogs        AuditLog[]
  onboardingTokens OnboardingToken[]
}

model User {
  id            String      @id @default(uuid())
  institutionId String
  email         String?
  phoneNumber   String
  passwordHash  String
  role          UserRole
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  guardians     Guardian[]
  students      Student[]
  sectionsTaught Section[]  @relation("ClassTeacher")
  attendanceMarked Attendance[]
  marksEntered  StudentMarks[]
  paymentsCollected FeePayment[]
  auditLogs     AuditLog[]
  
  @@unique([institutionId, phoneNumber])
  @@unique([institutionId, email])
}

model AcademicYear {
  id            String              @id @default(uuid())
  institutionId String
  name          String              // e.g., "2025-2026"
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  enrollments   StudentEnrollment[]
  examTerms     ExamTerm[]
  feeCards      FeeCard[]
  
  @@unique([institutionId, name])
}

model Class {
  id            String        @id @default(uuid())
  institutionId String
  name          String        // LKG, UKG, Class 1-12
  stream        String?       // SCIENCE, COMMERCE, ARTS
  sequenceOrder Int
  createdAt     DateTime      @default(now())
  
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sections      Section[]
  classSubjects ClassSubject[]
  feeCards      FeeCard[]
  
  @@unique([institutionId, name, stream])
}

model Section {
  id             String              @id @default(uuid())
  classId        String
  name           String              // A, B, C
  maxCapacity    Int                 @default(40)
  classTeacherId String?
  roomNumber     String?
  createdAt      DateTime            @default(now())
  
  class          Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacher   User?               @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  enrollments    StudentEnrollment[]
  
  @@unique([classId, name])
}

model Guardian {
  id                 String     @id @default(uuid())
  institutionId      String
  userId             String?
  fatherName         String
  fatherOccupation   String?
  fatherPhone        String
  fatherEmail        String?
  motherName         String
  motherOccupation   String?
  motherPhone        String?
  motherEmail        String?
  residentialAddress String
  emergencyContact   String
  createdAt          DateTime   @default(now())
  
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user               User?       @relation(fields: [userId], references: [id])
  students           Student[]
  onboardingTokens   OnboardingToken[]
}

model Student {
  id               String              @id @default(uuid())
  institutionId    String
  userId           String?
  guardianId       String
  admissionNumber  String
  firstName        String
  middleName       String?
  lastName         String
  dob              DateTime
  gender           GenderType
  bloodGroup       String?
  nationalId       String?
  religion         String?
  casteCategory    String?
  photoUrl         String?
  medicalAllergies String?
  chronicIllness   String?
  status           StudentStatus       @default(ACTIVE)
  admissionDate    DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  institution      Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user             User?               @relation(fields: [userId], references: [id])
  guardian         Guardian            @relation(fields: [guardianId], references: [id])
  enrollments      StudentEnrollment[]
  documents        StudentDocument[]
  onboardingTokens OnboardingToken[]
  
  @@unique([institutionId, admissionNumber])
  @@unique([institutionId, nationalId])
}

model StudentEnrollment {
  id             String        @id @default(uuid())
  studentId      String
  sectionId      String
  academicYearId String
  rollNumber     Int
  createdAt      DateTime      @default(now())
  
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section        Section       @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  attendance     Attendance[]
  studentMarks   StudentMarks[]
  feeInvoices    FeeInvoice[]
  
  @@unique([sectionId, academicYearId, rollNumber])
  @@unique([studentId, academicYearId])
}

model StudentDocument {
  id           String    @id @default(uuid())
  studentId    String
  documentType String    // BIRTH_CERTIFICATE, TRANSFER_CERTIFICATE, etc.
  filePath     String
  uploadedBy   String?
  uploadedAt   DateTime  @default(now())
  
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model OnboardingToken {
  id               String      @id @default(uuid())
  institutionId    String
  studentId        String
  guardianId       String
  otrCode          String      @unique
  secretToken      String      @unique
  isRedeemed       Boolean     @default(false)
  redeemedAt       DateTime?
  redeemedDeviceId String?
  expiresAt        DateTime
  createdAt        DateTime    @default(now())
  
  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian         Guardian    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String
  date         DateTime
  status       AttendanceStatus
  remarks      String?
  markedBy     String?
  createdAt    DateTime         @default(now())
  
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  marker       User?            @relation(fields: [markedBy], references: [id])
  
  @@unique([enrollmentId, date])
}

model Subject {
  id             String         @id @default(uuid())
  institutionId  String
  name           String
  code           String
  isCoScholastic Boolean        @default(false)
  createdAt      DateTime       @default(now())
  
  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  classSubjects  ClassSubject[]
  
  @@unique([institutionId, code])
}

model ClassSubject {
  id                 String        @id @default(uuid())
  classId            String
  subjectId          String
  maxTheoryMarks     Float         @default(80.0)
  maxPracticalMarks  Float         @default(20.0)
  passMarkPercentage Float         @default(33.0)
  createdAt          DateTime      @default(now())
  
  class              Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject            Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentMarks       StudentMarks[]
  
  @@unique([classId, subjectId])
}

model ExamTerm {
  id             String         @id @default(uuid())
  academicYearId String
  name           String         // Term 1 Mid-Term, Annual Final
  startDate      DateTime
  endDate        DateTime
  isLocked       Boolean        @default(false)
  lockedBy       String?
  lockedAt       DateTime?
  createdAt      DateTime       @default(now())
  
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentMarks   StudentMarks[]
}

model StudentMarks {
  id                    String            @id @default(uuid())
  examTermId            String
  enrollmentId          String
  classSubjectId        String
  theoryMarksObtained   Float             @default(0.0)
  practicalMarksObtained Float            @default(0.0)
  coScholasticGrade     String?
  isAbsent              Boolean           @default(false)
  teacherRemarks        String?
  enteredBy             String?
  updatedAt             DateTime          @updatedAt
  
  examTerm              ExamTerm          @relation(fields: [examTermId], references: [id], onDelete: Cascade)
  enrollment            StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  classSubject          ClassSubject      @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  enteredByUser         User?             @relation(fields: [enteredBy], references: [id])
  
  @@unique([examTermId, enrollmentId, classSubjectId])
}

model FeeHead {
  id            String      @id @default(uuid())
  institutionId String
  name          String      // Tuition Fee, Transport Fee
  isRefundable  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  feeCards      FeeCard[]
}

model FeeCard {
  id               String       @id @default(uuid())
  institutionId    String
  classId          String
  academicYearId   String
  feeHeadId        String
  amount           Float
  billingFrequency String       // ONE_TIME, MONTHLY, TERMWISE, ANNUAL
  createdAt        DateTime     @default(now())
  
  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class            Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeHead          FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)
  
  @@unique([classId, academicYearId, feeHeadId])
}

model FeeInvoice {
  id               String            @id @default(uuid())
  institutionId    String
  enrollmentId     String
  invoiceNumber    String            @unique
  dueDate          DateTime
  subtotal         Float
  concessionAmount Float             @default(0.0)
  lateFineAmount   Float             @default(0.0)
  totalAmount      Float
  paidAmount       Float             @default(0.0)
  status           InvoiceStatus     @default(PENDING)
  createdAt        DateTime          @default(now())
  
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  enrollment       StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  payments         FeePayment[]
}

model FeePayment {
  id                   String      @id @default(uuid())
  invoiceId            String
  receiptNumber        String      @unique
  amountPaid           Float
  paymentMode          PaymentMode
  transactionReference String?
  collectedBy          String?
  paymentDate          DateTime    @default(now())
  
  invoice              FeeInvoice  @relation(fields: [invoiceId], references: [id])
  collector            User?       @relation(fields: [collectedBy], references: [id])
}

model AuditLog {
  id            String      @id @default(uuid())
  institutionId String
  userId        String?
  action        String
  tableAffected String
  recordId      String
  oldData       Json?
  newData       Json?
  ipAddress     String?
  createdAt     DateTime    @default(now())
  
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])
}