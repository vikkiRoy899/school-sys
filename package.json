{
  "name": "school-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:teacher-staff\"",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:teacher-staff": "npm run dev --workspace=apps/teacher-staff-app",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:parent-student": "npm run build --workspace=apps/parent-student-app",
    "build:teacher-staff": "npm run build --workspace=apps/teacher-staff-app",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:push": "npm run db:push --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "memory:save": "node memory/save.js",
    "memory:load": "node memory/load.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}